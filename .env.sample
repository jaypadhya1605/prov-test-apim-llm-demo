# Reference only: the standard-library harness reads process environment variables.
# No dotenv loader is required. Set these values in your own shell.
AZURE_SUBSCRIPTION_ID=<your-subscription-guid>
LAB_RESOURCE_GROUP=<your-isolated-lab-resource-group>
LAB_FOUNDRY_ACCOUNT=<your-globally-unique-foundry-account>
LAB_PROJECT_NAME=<your-foundry-project>
LAB_MODEL_DEPLOYMENT=lab-model
LAB_APIM_CLASSIC_NAME=<your-globally-unique-classic-gateway>
LAB_APIM_V2_NAME=<your-globally-unique-v2-gateway>
# Optional: set only when you have a verified stable public egress IP.
LAB_CALLER_IP=
